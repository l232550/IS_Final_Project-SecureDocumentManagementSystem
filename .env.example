# Copy to .env and edit. NEVER commit .env. This file holds NO keys (keys live in private_storage/keys).
APP_ENV=development
APP_TIMEZONE=Asia/Karachi
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=sdms
DB_USER=root
DB_PASS=root
# Optional separate append-only audit DB user (see database/audit_user.sql). Leave empty to reuse DB_USER.
DB_AUDIT_USER=
DB_AUDIT_PASS=
# Optional override; default is <project>/private_storage (must be OUTSIDE the web root)
STORAGE_PATH=
# Used only by bin/backup.php
MYSQLDUMP_PATH=/Applications/MAMP/Library/bin/mysqldump
